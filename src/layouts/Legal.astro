---
import '../styles/global.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/700.css';
import { site, legal } from '../content';
interface Props { title: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Draft marker: shows while any [bracketed] placeholder is still in src/content.ts
const draft = [legal.street, legal.city, legal.email].some((v) => v.startsWith('['));
---
<!doctype html>
<html lang={site.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#fbf5e9" />
  <title>{title} – {site.name}</title>
</head>
<body class="legal-page">
  <main class="legal">
    <a class="back" href={`${base}/`}>← {legal.back}</a>
    <h1>{title}</h1>
    {draft && <p class="draft">Entwurf: Die Angaben in [eckigen Klammern] müssen noch ausgefüllt und der Text rechtlich geprüft werden.</p>}
    <slot />
  </main>
</body>
</html>
